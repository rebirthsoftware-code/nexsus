# --- Yönetim paneli veritabanı (Supabase) ---
# Tanımlıysa başvurular veritabanına yazılır ve /admin panelinde görünür.
# Boşsa panel örnek verilerle "demo" modunda çalışır.
# Bu iki değer herkese açıktır (anon anahtarı); gizli "service_role" anahtarını ASLA buraya yazmayın.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# (Yeni Supabase projelerinde ve Vercel eklentisinde aynı anahtarın adı NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY; ikisi de çalışır.)

# Bildirim sunucusunun AÇIK anahtarı ("npm run vapid" ile üretilir). Gizli anahtar yalnızca Supabase'e yazılır.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Başvuruların kaydedileceği adres (isteğe bağlı), ör. Google Sheets'e yazan Apps Script web uygulaması.
# Boşsa form, başvuru metnini hazırlayıp Instagram mesajı olarak göndermeye yönlendirir.
# Tarayıcıda çalıştığı için gizli bilgi içermemelidir.
NEXT_PUBLIC_APPLICATION_ENDPOINT=

# Yalnızca GitHub Pages yayınında otomatik verilir; elle ayarlamanız gerekmez.
# NEXT_PUBLIC_BASE_PATH=/nexsus
# NEXT_PUBLIC_SITE_URL=https://kullanici.github.io/nexsus
